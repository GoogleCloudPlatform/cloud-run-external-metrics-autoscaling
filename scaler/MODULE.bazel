CREMA_VERSION = "0.1"

module(
    name = "crema",
    version = CREMA_VERSION,
)

################
# Bazel module #
################

bazel_dep(name = "protobuf", version = "31.1")
bazel_dep(name = "grpc-java", version = "1.78.0")
bazel_dep(name = "grpc-proto", version = "0.0.0-20240627-ec30f58")
bazel_dep(name = "rules_jvm_external", version = "6.7")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

CLOUD_MONITORING_PROTO_VERSION = "3.83.0"
PROTOBUF_VERSION = "4.33.4"
FLOGGER_VERSION = "0.8"

maven.install(
    artifacts = [
        "com.google.api.grpc:proto-google-cloud-monitoring-v3:" + CLOUD_MONITORING_PROTO_VERSION,
        "com.google.cloud:google-cloud-monitoring:" + CLOUD_MONITORING_PROTO_VERSION,
        "com.google.cloud:google-cloud-run:0.78.0",
        "com.google.code.gson:gson:2.13.2",
        "com.google.flogger:flogger:" + FLOGGER_VERSION,
        "com.google.flogger:flogger-system-backend:" + FLOGGER_VERSION,
        "com.google.guava:guava:33.5.0-jre",
        "com.google.protobuf:protobuf-java:" + PROTOBUF_VERSION,
        "com.google.protobuf:protobuf-java-util:" + PROTOBUF_VERSION,
        "com.google.truth:truth:1.4.5",
        "io.netty:netty-codec-http:4.1.137.Final",
        "io.netty:netty-codec-http2:4.1.137.Final",
        "io.netty:netty-handler:4.1.137.Final",
        "io.netty:netty-handler-proxy:4.1.137.Final",
        "io.netty:netty-transport-native-epoll:4.1.137.Final",
        "junit:junit:4.13.2",
        "org.mockito:mockito-core:5.17.0",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://maven.google.com",
    ],
)

use_repo(maven, "maven")